# Observabilidade. Cada fornecedor só liga quando todos os campos dele estão preenchidos.
# Copie para .env.local (ignorado pelo git) ou defina em Vercel > Settings > Environment Variables.
# Atenção: variáveis VITE_* vão para o navegador. Use só chaves feitas para o navegador (DSN, client token, license key).

# Sentry
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Datadog RUM
VITE_DD_APPLICATION_ID=
VITE_DD_CLIENT_TOKEN=
VITE_DD_SITE=datadoghq.com

# New Relic Browser
VITE_NR_LICENSE_KEY=
VITE_NR_APPLICATION_ID=
VITE_NR_ACCOUNT_ID=
VITE_NR_TRUST_KEY=
VITE_NR_AGENT_ID=

# OpenTelemetry (endpoint OTLP/HTTP de traços, por exemplo https://collector.exemplo.com/v1/traces)
VITE_OTEL_EXPORTER_URL=

# Nome do serviço nos painéis
VITE_SERVICE_NAME=exoplanetas-site
